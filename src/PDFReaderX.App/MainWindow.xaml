<Window x:Class="PDFReaderX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PDFReaderX.App.Controls"
        xmlns:converters="clr-namespace:PDFReaderX.App.Converters"
        Title="PDFReader X"
        Icon="Resources/AppLogo.ico"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnWindowClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrush"/>
        <converters:EnumToBoolConverter x:Key="EnumToBool"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVis"/>
        <converters:EqualityToVisibilityConverter x:Key="EqualityToVis"/>
        <converters:WidthToDotSizeConverter x:Key="WidthToDot"/>
        <Style x:Key="InkToolButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ToolBg" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ToolContent" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToolBg" Property="Background" Value="#FF2D6CDF"/>
                                <Setter TargetName="ToolContent" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolBg" Property="Background" Value="#FFE8F0FE"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ToolBg" Property="Background" Value="#FF2D6CDF"/>
                                <Setter TargetName="ToolContent" Property="TextElement.Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#FFE8F0FE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFC8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                <Grid>
                                    <ToggleButton Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed"
                                             Background="Transparent" BorderThickness="0" Focusable="True"
                                             Foreground="#FF222222" CaretBrush="#FF2D6CDF"
                                             Margin="6,2,18,2" Padding="0"
                                             VerticalContentAlignment="Center"/>
                                    <Path Data="M 0,0 L 4,4 L 8,0 Z" Fill="#FF666666" HorizontalAlignment="Right"
                                          Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#FFC8C8C8" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2D6CDF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2D6CDF"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

                <Border x:Name="FileToolbar" Grid.Row="0" Background="#FFFBFAF8" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="打开 PDF" Style="{StaticResource ToolbarButton}" Command="{Binding OpenCommand}"/>
                <Button Content="关闭" Style="{StaticResource ToolbarButton}" Command="{Binding CloseCommand}"/>
                <Border Width="1" Height="22" Background="#FFD9D9D9" Margin="6,0"/>
                <Button Content="保存" Style="{StaticResource ToolbarButton}" Click="OnSavePdfrxClick"
                        ToolTip="保存批注到 .pdfrx：打开批注文档时直接覆盖保存，普通 PDF 时另存为新批注文档"/>
                <Button Content="导出 PDF" Style="{StaticResource ToolbarButton}" Click="OnExportPdfClick"
                        ToolTip="把墨迹与元素合并渲染导出为新的 PDF 文件"/>
                <Border Width="1" Height="22" Background="#FFD9D9D9" Margin="6,0"/>
                <Button Content="设置" Style="{StaticResource ToolbarButton}" Command="{Binding OpenSettingsCommand}"
                        ToolTip="LLM、书签与通用设置"/>
                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#FF555555"/>
            </StackPanel>
        </Border>


                <Grid x:Name="DrawingToolbar" Grid.Row="1" Background="#FFF8F8F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <RadioButton Content="选择" Style="{StaticResource InkToolButton}" GroupName="InkTool"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Select}"
                             ToolTip="选择/移动元素"/>
                <RadioButton Content="钢笔" Style="{StaticResource InkToolButton}" GroupName="InkTool"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Pen}"
                             ToolTip="手写笔迹"/>
                <RadioButton Content="荧光笔" Style="{StaticResource InkToolButton}" GroupName="InkTool"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Highlighter}"
                             ToolTip="荧光笔标注"/>
                <RadioButton Content="橡皮擦" Style="{StaticResource InkToolButton}" GroupName="InkTool"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Eraser}"
                             ToolTip="擦除墨迹"/>
                <RadioButton Content="文本" Style="{StaticResource InkToolButton}" GroupName="InkTool"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Text}"
                             ToolTip="点击画布插入文本框，回车确认、Esc 取消"/>
                <RadioButton Content="套索" Style="{StaticResource InkToolButton}" GroupName="InkTool"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Lasso}"
                             ToolTip="圈选墨迹笔划，Delete 删除选中的笔划"/>
                <Border Width="1" Height="24" Background="#FFD9D9D9" Margin="8,0"/>
                <Button Content="图片" Style="{StaticResource ToolbarButton}" Click="OnInsertImageClick"
                        ToolTip="从文件插入图片到画布（也可 Ctrl+V 粘贴或直接拖入）"/>
                <Button x:Name="UndoButton" Content="撤销" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="OnUndoClick"
                        ToolTip="撤销上一步操作 (Ctrl+Z)"/>
                <Button x:Name="RedoButton" Content="重做" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="OnRedoClick"
                        ToolTip="重做已撤销的操作 (Ctrl+Y)"/>
                <Border Width="1" Height="24" Background="#FFD9D9D9" Margin="8,0"/>
                <TextBlock Text="字号" VerticalAlignment="Center" Margin="6,0,2,0" Foreground="#FF333333"/>
                <ComboBox Width="64" Style="{StaticResource FlatComboBox}" IsEditable="True" ItemsSource="{Binding TextFontSizes}"
                          SelectedItem="{Binding TextFontSize}" PreviewKeyDown="OnFontSizePreviewKeyDown"
                          LostFocus="OnFontSizeLostFocus" ToolTip="文本框字号：可输入 6~144 自定义，编辑中立即生效"/>
                <Button Content="B" FontWeight="Bold" Width="28" Height="28" Style="{StaticResource ToolbarButton}" Click="OnBoldClick"
                        ToolTip="加粗（编辑文本框时 Ctrl+B）"/>
                <Button Content="I" FontStyle="Italic" Width="28" Height="28" Style="{StaticResource ToolbarButton}" Click="OnItalicClick"
                        ToolTip="斜体（编辑文本框时 Ctrl+I）"/>
                <Button Width="28" Height="28" Style="{StaticResource ToolbarButton}" Click="OnUnderlineClick"
                        ToolTip="下划线（编辑文本框时 Ctrl+U）">
                    <TextBlock Text="U" TextDecorations="Underline"/>
                </Button>
                <Border Width="1" Height="24" Background="#FFD9D9D9" Margin="8,0"/>
                <TextBlock Text="缩放" VerticalAlignment="Center" Margin="6,0,2,0" Foreground="#FF333333"/>
                <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" VerticalAlignment="Center" MinWidth="44"
                           Foreground="#FF444444"/>
                <Button Content="重置" Style="{StaticResource ToolbarButton}" Click="OnResetZoomClick"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,4,6"
                        Visibility="{Binding ActiveTool, Converter={StaticResource EnumToVis}, ConverterParameter=Pen}">
                <TextBlock Text="钢笔" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF2D6CDF"/>
                <ItemsControl ItemsSource="{Binding PenColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="26" Height="26" Margin="2,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonUp="OnPenColorSwatchClick" ToolTip="{Binding}">
                                <Ellipse Fill="{Binding Converter={StaticResource ColorToBrush}}" Margin="3"
                                         Stroke="#FFCCCCCC" StrokeThickness="1"/>
                                <Ellipse Stroke="#FF2D6CDF" StrokeThickness="2" Margin="1">
                                    <Ellipse.Visibility>
                                        <MultiBinding Converter="{StaticResource EqualityToVis}">
                                            <Binding Path="DataContext.PenColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </Ellipse.Visibility>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Width="1" Height="22" Background="#FFD9D9D9" Margin="10,2"/>
                <ItemsControl ItemsSource="{Binding PenWidths}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="28" Height="28" Margin="2,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonUp="OnPenWidthClick" ToolTip="{Binding}">
                                <Ellipse Stroke="#FF999999" StrokeThickness="1"
                                         Width="{Binding Converter={StaticResource WidthToDot}, ConverterParameter=pen}"
                                         Height="{Binding Converter={StaticResource WidthToDot}, ConverterParameter=pen}">
                                    <Ellipse.Fill>
                                        <Binding Path="DataContext.PenColor" RelativeSource="{RelativeSource AncestorType=Window}"
                                                 Converter="{StaticResource ColorToBrush}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Stroke="#FF2D6CDF" StrokeThickness="2" Margin="2">
                                    <Ellipse.Visibility>
                                        <MultiBinding Converter="{StaticResource EqualityToVis}">
                                            <Binding Path="DataContext.PenWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </Ellipse.Visibility>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,4,6"
                        Visibility="{Binding ActiveTool, Converter={StaticResource EnumToVis}, ConverterParameter=Highlighter}">
                <TextBlock Text="荧光笔" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF2D6CDF"/>
                <ItemsControl ItemsSource="{Binding HighlightColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="26" Height="26" Margin="2,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonUp="OnHighlightColorSwatchClick" ToolTip="{Binding}">
                                <Ellipse Fill="{Binding Converter={StaticResource ColorToBrush}}" Margin="3"
                                         Stroke="#FFCCCCCC" StrokeThickness="1"/>
                                <Ellipse Stroke="#FF2D6CDF" StrokeThickness="2" Margin="1">
                                    <Ellipse.Visibility>
                                        <MultiBinding Converter="{StaticResource EqualityToVis}">
                                            <Binding Path="DataContext.HighlightColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </Ellipse.Visibility>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Width="1" Height="22" Background="#FFD9D9D9" Margin="10,2"/>
                <ItemsControl ItemsSource="{Binding HighlightWidths}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="28" Height="28" Margin="2,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonUp="OnHighlightWidthClick" ToolTip="{Binding}">
                                <Ellipse Stroke="#FF999999" StrokeThickness="1"
                                         Width="{Binding Converter={StaticResource WidthToDot}, ConverterParameter=highlighter}"
                                         Height="{Binding Converter={StaticResource WidthToDot}, ConverterParameter=highlighter}">
                                    <Ellipse.Fill>
                                        <Binding Path="DataContext.HighlightColor" RelativeSource="{RelativeSource AncestorType=Window}"
                                                 Converter="{StaticResource ColorToBrush}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Stroke="#FF2D6CDF" StrokeThickness="2" Margin="2">
                                    <Ellipse.Visibility>
                                        <MultiBinding Converter="{StaticResource EqualityToVis}">
                                            <Binding Path="DataContext.HighlightWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </Ellipse.Visibility>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,4,6"
                        Visibility="{Binding ActiveTool, Converter={StaticResource EnumToVis}, ConverterParameter=Eraser}">
                <TextBlock Text="橡皮擦" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF2D6CDF"/>
                <ItemsControl ItemsSource="{Binding EraserWidths}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="28" Height="28" Margin="2,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonUp="OnEraserWidthClick" ToolTip="{Binding}">
                                <Ellipse Fill="#FF666666" Stroke="#FFCCCCCC" StrokeThickness="1"
                                         Width="{Binding Converter={StaticResource WidthToDot}, ConverterParameter=eraser}"
                                         Height="{Binding Converter={StaticResource WidthToDot}, ConverterParameter=eraser}"/>
                                <Ellipse Stroke="#FF2D6CDF" StrokeThickness="2" Margin="2">
                                    <Ellipse.Visibility>
                                        <MultiBinding Converter="{StaticResource EqualityToVis}">
                                            <Binding Path="DataContext.EraserWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </Ellipse.Visibility>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Margin="4,4,0,4">
                <TabItem Header="缩略图">
                    <Grid>
                        <ListBox x:Name="ThumbnailList"
                                 ItemsSource="{Binding Thumbnails}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="OnThumbnailListPreviewMouseWheel"
                                 SelectionChanged="OnThumbnailSelectionChanged"
                                 MouseEnter="OnThumbnailListMouseEnter"
                                 MouseLeave="OnThumbnailListMouseLeave"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#33007ACC"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.CurrentPageBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="3">
                                        <StackPanel>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   MaxHeight="220" MinHeight="40"/>
                                            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"
                                                       FontSize="11" Foreground="#FF555555" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="打开 PDF 后显示缩略图"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Thumbnails.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </TabItem>
                <TabItem Header="书签">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TreeView x:Name="BookmarkTree" Grid.Row="0"
                                  ItemsSource="{Binding Bookmarks}"
                                  Background="Transparent" BorderThickness="0"
                                  SelectedItemChanged="OnBookmarkSelectionChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PageLabel}" Foreground="Gray"
                                                   FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="该 PDF 没有书签目录" HorizontalAlignment="Center"
                                       Foreground="Gray"/>
                            <TextBlock Text="点击下方按钮用 AI 自动生成" HorizontalAlignment="Center"
                                       Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAutoBookmarkButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>
                        <Border Grid.Row="1" Padding="8" Background="#FFF7F7F7"
                        BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Margin="0,2" HorizontalAlignment="Stretch"
                                    Visibility="{Binding IsGeneratingBookmarks, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Height="4"/>
                            <TextBlock Text="{Binding BookmarkGenerationStatus}" FontSize="11"
                                       Foreground="#FF555555" HorizontalAlignment="Center"
                                       Margin="0,4,0,2" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="AI 生成书签" Command="{Binding AutoGenerateBookmarksCommand}"
                                HorizontalAlignment="Stretch" Margin="0,2"
                                Visibility="{Binding ShowAutoBookmarkButton, Converter={StaticResource BoolToVis}}"
                                ToolTip="用大模型阅读 PDF 内容，自动生成书签目录"/>
                    </StackPanel>
                </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Column="1" Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <controls:InfiniteCanvas x:Name="Canvas"
                                             Background="White"
                                             Document="{Binding Document}"
                                             Pages="{Binding Pages}"
                                             Zoom="{Binding Zoom, Mode=TwoWay}"
                                             ActiveTool="{Binding ActiveTool}"
                                             PenColor="{Binding PenColor}"
                                             PenWidth="{Binding PenWidth}"
                                             HighlightColor="{Binding HighlightColor}"
                                             HighlightWidth="{Binding HighlightWidth}"
                                             EraserWidth="{Binding EraserWidth}"
                                             TextBorderStyle="{Binding TextBorderStyle}"
                                             TextFontSize="{Binding TextFontSize}"
                                             PerformanceMode="{Binding PerformanceMode}"/>
                    <TextBlock Text="打开一个 PDF 文件开始"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="20" Foreground="#FF909090">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ScrollBar Grid.Column="1" Orientation="Vertical" Margin="2,0,0,0"
                           Minimum="0"
                           Maximum="{Binding MaxScrollOffset, ElementName=Canvas}"
                           ViewportSize="{Binding ViewportHeight, ElementName=Canvas}"
                           Value="{Binding ScrollOffset, ElementName=Canvas, Mode=TwoWay}"
                           SmallChange="48" LargeChange="240"/>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Zoom, StringFormat=缩放 {0:P0}}" Margin="12,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="True" Height="16" Width="120"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StatusBarItem>
        </StatusBar>

        <Border x:Name="SaveToast" Grid.RowSpan="4"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,36" Padding="14,8" CornerRadius="6"
                Background="#E6202020" IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="SaveToastText" Foreground="White" FontSize="13"/>
        </Border>
    </Grid>
</Window>


