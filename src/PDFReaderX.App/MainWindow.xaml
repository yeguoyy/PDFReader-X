<Window x:Class="PDFReaderX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDFReader X"
        Icon="Resources/AppLogo.ico"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Content="打开 PDF" Command="{Binding OpenCommand}" Margin="4,2"/>
            <Button Content="关闭" Command="{Binding CloseCommand}" Margin="4,2"/>
            <Separator/>
            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="4,0"/>
        </ToolBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Margin="4,4,0,4">
                <TabItem Header="缩略图">
                    <TextBlock Text="缩略图面板（Phase 3）"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                </TabItem>
                <TabItem Header="书签">
                    <TextBlock Text="书签面板（Phase 3）"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                </TabItem>
            </TabControl>

            <Border Grid.Column="1" Background="#FFE8E8E8" Margin="4">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Pages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="12,6" Padding="10" Background="White"
                                            BorderBrush="#FFCCCCCC" BorderThickness="1">
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Stretch="None"
                                                   Width="{Binding Width}" Height="{Binding Height}"/>
                                            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"
                                                       Foreground="#FF808080" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="打开一个 PDF 文件开始"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="20" Foreground="#FF909090">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="True" Height="16" Width="120"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
