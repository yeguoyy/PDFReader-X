<Window x:Class="PDFReaderX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PDFReaderX.App.Controls"
        xmlns:converters="clr-namespace:PDFReaderX.App.Converters"
        Title="PDFReader X"
        Icon="Resources/AppLogo.ico"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnWindowClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrush"/>
        <converters:EnumToBoolConverter x:Key="EnumToBool"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVis"/>
        <converters:EqualityToVisibilityConverter x:Key="EqualityToVis"/>
        <converters:WidthToDotSizeConverter x:Key="WidthToDot"/>
        <converters:QuickPenSelectedConverter x:Key="QuickPenSelected"/>

        <!-- 快捷笔图标：钢笔（细长笔身+尖笔尖） -->
        <DataTemplate x:Key="QuickPenIconPen">
            <Grid Width="26" Height="26">
                <Path Data="M 4 24 L 13 15 L 15 17 L 6 26 Z" Fill="#FF9A9A9A"/>
                <Path Data="M 13 15 L 22 6 L 15 17 Z" Fill="{Binding Color, Converter={StaticResource ColorToBrush}}"/>
                <Path Data="M 13 15 L 17.5 10.5" Stroke="White" StrokeThickness="0.9" Opacity="0.75"/>
            </Grid>
        </DataTemplate>

        <!-- 快捷笔图标：荧光笔（宽扁笔头马克笔） -->
        <DataTemplate x:Key="QuickPenIconHighlighter">
            <Grid Width="26" Height="26">
                <Path Data="M 2 22 L 10 14 L 15 19 L 7 27 Z" Fill="#FFB8C8E2"/>
                <Path Data="M 10 14 L 19 5 L 24 10 L 15 19 Z" Fill="{Binding Color, Converter={StaticResource ColorToBrush}}" Opacity="0.55"/>
                <Path Data="M 10 14 L 15 19" Stroke="#FF7A8AA5" StrokeThickness="1"/>
            </Grid>
        </DataTemplate>
        <controls:QuickPenIconSelector x:Key="QuickPenIconSelector"
                                       PenTemplate="{StaticResource QuickPenIconPen}"
                                       HighlighterTemplate="{StaticResource QuickPenIconHighlighter}"/>
        <Style x:Key="InkToolButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ToolBg" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ToolContent" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToolBg" Property="Background" Value="#FF2D6CDF"/>
                                <Setter TargetName="ToolContent" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolBg" Property="Background" Value="#FFE8F0FE"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ToolBg" Property="Background" Value="#FF2D6CDF"/>
                                <Setter TargetName="ToolContent" Property="TextElement.Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickPenButton" TargetType="Button">
            <Setter Property="Margin" Value="1,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#FFE8F0FE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#FFC9DDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickPenAddButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,2"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#FFE8F0FE"/>
                                <Setter Property="Foreground" Value="#FF2D6CDF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#FFC9DDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolArrowButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="0,2,2,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3">
                            <Path x:Name="Arrow" Data="M 0,0 L 5,0 L 2.5,3.5 Z" Fill="#FF777777"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2D6CDF"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#FFE8F0FE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFC8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                <Grid>
                                    <ToggleButton Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed"
                                             Background="Transparent" BorderThickness="0" Focusable="True"
                                             Foreground="#FF222222" CaretBrush="#FF2D6CDF"
                                             Margin="6,2,18,2" Padding="0"
                                             VerticalContentAlignment="Center"/>
                                    <Path Data="M 0,0 L 4,4 L 8,0 Z" Fill="#FF666666" HorizontalAlignment="Right"
                                          Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#FFC8C8C8" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2D6CDF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2D6CDF"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

                <Border x:Name="FileToolbar" Grid.Row="0" Background="#FFFBFAF8" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="打开 PDF" Style="{StaticResource ToolbarButton}" Command="{Binding OpenCommand}"/>
                <Button Content="关闭" Style="{StaticResource ToolbarButton}" Command="{Binding CloseCommand}"/>
                <Border Width="1" Height="22" Background="#FFD9D9D9" Margin="6,0"/>
                <Button Content="保存" Style="{StaticResource ToolbarButton}" Click="OnSavePdfrxClick"
                        ToolTip="保存批注到 .pdfrx：打开批注文档时直接覆盖保存，普通 PDF 时另存为新批注文档"/>
                <Button Content="导出 PDF" Style="{StaticResource ToolbarButton}" Click="OnExportPdfClick"
                        ToolTip="把墨迹与元素合并渲染导出为新的 PDF 文件"/>
                <Border Width="1" Height="22" Background="#FFD9D9D9" Margin="6,0"/>
                <Button Content="设置" Style="{StaticResource ToolbarButton}" Command="{Binding OpenSettingsCommand}"
                        ToolTip="LLM、书签与通用设置"/>
                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#FF555555"/>
            </StackPanel>
        </Border>


                <Grid x:Name="DrawingToolbar" Grid.Row="1" Background="#FFF8F8F8">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Button x:Name="UndoButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="OnUndoClick"
                        ToolTip="撤销上一步操作 (Ctrl+Z)">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M12.5,8c-2.65,0 -5.05,0.99 -6.9,2.6L2,7v9h9l-3.62,-3.62c1.39,-1.16 3.16,-1.88 5.12,-1.88 3.54,0 6.55,2.31 7.6,5.5l2.37,-0.78C21.08,11.03 17.15,8 12.5,8z"
                              Fill="#FF444444"/>
                    </Viewbox>
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource ToolbarButton}" IsEnabled="False" Click="OnRedoClick"
                        ToolTip="重做已撤销的操作 (Ctrl+Y)">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M18.4,10.6C16.55,8.99 14.15,8 11.5,8c-4.65,0 -8.58,3.03 -9.96,7.22L3.9,16c1.05,-3.19 4.05,-5.5 7.6,-5.5 1.95,0 3.73,0.72 5.12,1.88L13,16h9V7L18.4,10.6z"
                              Fill="#FF444444"/>
                    </Viewbox>
                </Button>
                <Border Width="1" Height="24" Background="#FFD9D9D9" Margin="4,0"/>
                <RadioButton Style="{StaticResource InkToolButton}" GroupName="InkTool"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Select}"
                             ToolTip="选择/移动元素">
                    <Viewbox Width="17" Height="17">
                        <Path Data="M5.5,3.5 L5.5,19.5 L10,15.5 L12.7,21.5 L14.9,20.5 L12.2,14.5 L16,14.5 Z" Fill="#FF444444"/>
                    </Viewbox>
                </RadioButton>
                <RadioButton Style="{StaticResource InkToolButton}" GroupName="InkTool"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Lasso}"
                             ToolTip="套索：圈选墨迹笔划，Delete 删除选中的笔划">
                    <Viewbox Width="17" Height="17">
                        <Grid Width="16" Height="16">
                            <Path Data="M 2.5 8 A 5.5 5.5 0 1 0 13.5 8 A 5.5 5.5 0 1 0 2.5 8"
                                  Stroke="#FF444444" StrokeThickness="1.5" StrokeDashArray="1.9 1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            <Path Data="M 11.9 11.9 C 12.6 12.9 13.4 13.9 14.1 14.8"
                                  Stroke="#FF444444" StrokeThickness="1.5" StrokeDashArray="1.9 1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Grid>
                    </Viewbox>
                </RadioButton>
                <Border Width="1" Height="24" Background="#FFD9D9D9" Margin="4,0"/>
                <ItemsControl x:Name="QuickPensPanel" ItemsSource="{Binding QuickPens}" Margin="2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource QuickPenButton}" Tag="{Binding}"
                                    ToolTip="{Binding Name, StringFormat={}{0}（长按可拖动排序）}"
                                    PreviewMouseLeftButtonDown="OnQuickPenPreviewMouseDown"
                                    PreviewMouseMove="OnQuickPenPreviewMouseMove"
                                    PreviewMouseLeftButtonUp="OnQuickPenPreviewMouseUp">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="删除这支笔" Click="OnDeleteQuickPenClick"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="26" Height="28">
                                    <Border x:Name="SelBg" Background="#FF2D6CDF" CornerRadius="3" Margin="-3">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource QuickPenSelected}">
                                                <Binding Path="Tool"/>
                                                <Binding Path="Color"/>
                                                <Binding Path="Width"/>
                                                <Binding Path="DataContext.ActiveTool" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.PenColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.PenWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.HighlightColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.HighlightWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                    </Border>
                                    <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource QuickPenIconSelector}"
                                                    Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path Data="M 3.5,14 L 7.5,18 L 14.5,9" Stroke="White" StrokeThickness="1.8"
                                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                                          Visibility="{Binding Visibility, ElementName=SelBg}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource QuickPenAddButton}" Content="+" Click="OnAddQuickPenClick"
                        ToolTip="新建一支笔（颜色/粗细可自定义）"/>
                <Border Width="1" Height="24" Background="#FFD9D9D9" Margin="4,0"/>
                <Grid Margin="2,2">
                    <RadioButton Style="{StaticResource InkToolButton}" GroupName="InkTool"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Pen}"
                                 ToolTip="手写笔迹；点右下角箭头调整颜色与粗细">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Grid Width="16" Height="16">
                                    <Path Data="M 2 14 L 8 8 L 10 10 L 4 16 Z" Fill="#FF9A9A9A"/>
                                    <Path Data="M 8 8 L 14 2 L 10 10 Z" Fill="{Binding PenColor, Converter={StaticResource ColorToBrush}}"/>
                                    <Path Data="M 8 8 L 10.5 5.5" Stroke="White" StrokeThickness="0.7" Opacity="0.75"/>
                                </Grid>
                            </Viewbox>

                        </StackPanel>
                    </RadioButton>
                    <ToggleButton x:Name="PenArrow" Tag="Pen" Style="{StaticResource ToolArrowButton}" Click="OnToolArrowClick"
                                  ToolTip="颜色与粗细设置"/>
                    <Popup IsOpen="{Binding IsChecked, ElementName=PenArrow, Mode=TwoWay}" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=PenArrow}"
                           AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                        <controls:InkToolOptionsPanel x:Name="PenPanel" PreviewKind="pen"
                            CurrentColor="{Binding PenColor, Mode=OneWay}"
                            CurrentWidth="{Binding PenWidth, Mode=OneWay}"
                            WidthPresets="{Binding PenWidths}"
                            ColorOptions="{Binding PenColors}"
                            RecentColors="{Binding RecentColors}"
                            ColorPicked="OnPenColorPicked" WidthPicked="OnPenWidthPicked"
                            MoreColorsClicked="OnPenMoreColorsClicked" EyedropperClicked="OnPenEyedropperClicked"/>
                    </Popup>
                </Grid>
                <Grid Margin="2,2">
                    <RadioButton Style="{StaticResource InkToolButton}" GroupName="InkTool"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Highlighter}"
                                 ToolTip="荧光笔标注；点右下角箭头调整颜色与粗细">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Grid Width="16" Height="16">
                                    <Path Data="M 1 13 L 6 8 L 9 11 L 4 16 Z" Fill="#FFB8C8E2"/>
                                    <Path Data="M 6 8 L 11 3 L 14 6 L 9 11 Z" Fill="{Binding HighlightColor, Converter={StaticResource ColorToBrush}}" Opacity="0.55"/>
                                </Grid>
                            </Viewbox>

                        </StackPanel>
                    </RadioButton>
                    <ToggleButton x:Name="HighlightArrow" Tag="Highlighter" Style="{StaticResource ToolArrowButton}" Click="OnToolArrowClick"
                                  ToolTip="颜色与粗细设置"/>
                    <Popup IsOpen="{Binding IsChecked, ElementName=HighlightArrow, Mode=TwoWay}" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=HighlightArrow}"
                           AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                        <controls:InkToolOptionsPanel x:Name="HighlightPanel" PreviewKind="highlighter"
                            CurrentColor="{Binding HighlightColor, Mode=OneWay}"
                            CurrentWidth="{Binding HighlightWidth, Mode=OneWay}"
                            WidthPresets="{Binding HighlightWidths}"
                            ColorOptions="{Binding HighlightColors}"
                            RecentColors="{Binding RecentColors}"
                            ColorPicked="OnHighlightColorPicked" WidthPicked="OnHighlightWidthPicked"
                            MoreColorsClicked="OnHighlightMoreColorsClicked" EyedropperClicked="OnHighlightEyedropperClicked"/>
                    </Popup>
                </Grid>
                <Grid Margin="2,2">
                    <RadioButton Style="{StaticResource InkToolButton}" GroupName="InkTool"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Eraser}"
                                 ToolTip="擦除墨迹；点右下角箭头调整橡皮大小">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Grid Width="16" Height="16">
                                    <Path Data="M 2.5 9.5 L 7 5 L 13 11 L 8.5 15.5 Z" Fill="#FFE5A5B8"/>
                                    <Path Data="M 8.5 15.5 L 13 11 L 14.5 12.5 L 10 17 Z" Fill="#FF7FA8D0"/>
                                </Grid>
                            </Viewbox>

                        </StackPanel>
                    </RadioButton>
                    <ToggleButton x:Name="EraserArrow" Tag="Eraser" Style="{StaticResource ToolArrowButton}" Click="OnToolArrowClick"
                                  ToolTip="橡皮大小设置"/>
                    <Popup IsOpen="{Binding IsChecked, ElementName=EraserArrow, Mode=TwoWay}" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=EraserArrow}"
                           AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                        <controls:InkToolOptionsPanel x:Name="EraserPanel" PreviewKind="eraser"
                            CurrentWidth="{Binding EraserWidth, Mode=OneWay}"
                            WidthPresets="{Binding EraserWidths}"
                            WidthPicked="OnEraserWidthPicked"/>
                    </Popup>
                </Grid>
                <RadioButton Style="{StaticResource InkToolButton}" GroupName="InkTool"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Text}"
                             ToolTip="点击画布插入文本框，回车确认、Esc 取消">
                    <Viewbox Width="18" Height="18">
                        <TextBlock Text="A" FontFamily="Georgia" FontWeight="Bold" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                </RadioButton>
                <Border Width="1" Height="24" Background="#FFD9D9D9" Margin="8,0"/>
                <Button Content="图片" Style="{StaticResource ToolbarButton}" Click="OnInsertImageClick"
                        ToolTip="从文件插入图片到画布（也可 Ctrl+V 粘贴或直接拖入）"/>
                
                <Border Width="1" Height="24" Background="#FFD9D9D9" Margin="8,0"/>
                <TextBlock Text="字号" VerticalAlignment="Center" Margin="6,0,2,0" Foreground="#FF333333"/>
                <ComboBox Width="64" Style="{StaticResource FlatComboBox}" IsEditable="True" ItemsSource="{Binding TextFontSizes}"
                          SelectedItem="{Binding TextFontSize}" PreviewKeyDown="OnFontSizePreviewKeyDown"
                          LostFocus="OnFontSizeLostFocus" ToolTip="文本框字号：可输入 6~144 自定义，编辑中立即生效"/>
                <Button Content="B" FontWeight="Bold" Width="28" Height="28" Style="{StaticResource ToolbarButton}" Click="OnBoldClick"
                        ToolTip="加粗（编辑文本框时 Ctrl+B）"/>
                <Button Content="I" FontStyle="Italic" Width="28" Height="28" Style="{StaticResource ToolbarButton}" Click="OnItalicClick"
                        ToolTip="斜体（编辑文本框时 Ctrl+I）"/>
                <Button Width="28" Height="28" Style="{StaticResource ToolbarButton}" Click="OnUnderlineClick"
                        ToolTip="下划线（编辑文本框时 Ctrl+U）">
                    <TextBlock Text="U" TextDecorations="Underline"/>
                </Button>
                <Border Width="1" Height="24" Background="#FFD9D9D9" Margin="8,0"/>
                <TextBlock Text="缩放" VerticalAlignment="Center" Margin="6,0,2,0" Foreground="#FF333333"/>
                <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" VerticalAlignment="Center" MinWidth="44"
                           Foreground="#FF444444"/>
                <Button Content="重置" Style="{StaticResource ToolbarButton}" Click="OnResetZoomClick"/>
            </StackPanel>
        </Grid>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Margin="4,4,0,4">
                <TabItem Header="缩略图">
                    <Grid>
                        <ListBox x:Name="ThumbnailList"
                                 ItemsSource="{Binding Thumbnails}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="OnThumbnailListPreviewMouseWheel"
                                 SelectionChanged="OnThumbnailSelectionChanged"
                                 MouseEnter="OnThumbnailListMouseEnter"
                                 MouseLeave="OnThumbnailListMouseLeave"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#33007ACC"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.CurrentPageBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="3">
                                        <StackPanel>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   MaxHeight="220" MinHeight="40"/>
                                            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"
                                                       FontSize="11" Foreground="#FF555555" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="打开 PDF 后显示缩略图"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Thumbnails.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </TabItem>
                <TabItem Header="书签">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TreeView x:Name="BookmarkTree" Grid.Row="0"
                                  ItemsSource="{Binding Bookmarks}"
                                  Background="Transparent" BorderThickness="0"
                                  SelectedItemChanged="OnBookmarkSelectionChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PageLabel}" Foreground="Gray"
                                                   FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="该 PDF 没有书签目录" HorizontalAlignment="Center"
                                       Foreground="Gray"/>
                            <TextBlock Text="点击下方按钮用 AI 自动生成" HorizontalAlignment="Center"
                                       Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAutoBookmarkButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>
                        <Border Grid.Row="1" Padding="8" Background="#FFF7F7F7"
                        BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Margin="0,2" HorizontalAlignment="Stretch"
                                    Visibility="{Binding IsGeneratingBookmarks, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Height="4"/>
                            <TextBlock Text="{Binding BookmarkGenerationStatus}" FontSize="11"
                                       Foreground="#FF555555" HorizontalAlignment="Center"
                                       Margin="0,4,0,2" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="AI 生成书签" Command="{Binding AutoGenerateBookmarksCommand}"
                                HorizontalAlignment="Stretch" Margin="0,2"
                                Visibility="{Binding ShowAutoBookmarkButton, Converter={StaticResource BoolToVis}}"
                                ToolTip="用大模型阅读 PDF 内容，自动生成书签目录"/>
                    </StackPanel>
                </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <ToggleButton x:Name="SidebarToggle" Grid.Column="1" VerticalAlignment="Center"
                          Width="14" Height="52" Margin="-1,0,1,0" Padding="0"
                          Focusable="False" Click="OnSidebarToggleClick"
                          ToolTip="折叠侧栏">
                <Path x:Name="SidebarToggleIcon" Data="M 8 3 L 3 10 L 8 17"
                      Stroke="#FF666666" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
            </ToggleButton>

            <Grid Grid.Column="2" Margin="1,4,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <controls:InfiniteCanvas x:Name="Canvas"
                                             Background="White"
                                             Document="{Binding Document}"
                                             Pages="{Binding Pages}"
                                             Zoom="{Binding Zoom, Mode=TwoWay}"
                                             ActiveTool="{Binding ActiveTool}"
                                             PenColor="{Binding PenColor}"
                                             PenWidth="{Binding PenWidth}"
                                             HighlightColor="{Binding HighlightColor}"
                                             HighlightWidth="{Binding HighlightWidth}"
                                             EraserWidth="{Binding EraserWidth}"
                                             TextBorderStyle="{Binding TextBorderStyle}"
                                             TextFontSize="{Binding TextFontSize}"
                                             PerformanceMode="{Binding PerformanceMode}"/>
                    <TextBlock Text="打开一个 PDF 文件开始"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="20" Foreground="#FF909090">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ScrollBar Grid.Column="1" Orientation="Vertical" Margin="2,0,0,0"
                           Minimum="0"
                           Maximum="{Binding MaxScrollOffset, ElementName=Canvas}"
                           ViewportSize="{Binding ViewportHeight, ElementName=Canvas}"
                           Value="{Binding ScrollOffset, ElementName=Canvas, Mode=TwoWay}"
                           SmallChange="48" LargeChange="240"/>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Zoom, StringFormat=缩放 {0:P0}}" Margin="12,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="True" Height="16" Width="120"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StatusBarItem>
        </StatusBar>

        <Border x:Name="SaveToast" Grid.RowSpan="4"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,36" Padding="14,8" CornerRadius="6"
                Background="#E6202020" IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="SaveToastText" Foreground="White" FontSize="13"/>
        </Border>
    </Grid>
</Window>


