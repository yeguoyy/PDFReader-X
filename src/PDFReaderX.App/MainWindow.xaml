<Window x:Class="PDFReaderX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PDFReaderX.App.Controls"
        xmlns:converters="clr-namespace:PDFReaderX.App.Converters"
        Title="PDFReader X"
        Icon="Resources/AppLogo.ico"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnWindowClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrush"/>
        <converters:EnumToBoolConverter x:Key="EnumToBool"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Content="打开 PDF" Command="{Binding OpenCommand}" Margin="4,2"/>
            <Button Content="关闭" Command="{Binding CloseCommand}" Margin="4,2"/>
            <Separator/>
            <Button Content="保存" Click="OnSavePdfrxClick" Margin="4,2"
                    ToolTip="保存批注到 .pdfrx：打开批注文档时直接覆盖保存，普通 PDF 时另存为新批注文档"/>
            <Button Content="导出 PDF" Click="OnExportPdfClick" Margin="4,2"
                    ToolTip="把墨迹与元素合并渲染导出为新的 PDF 文件"/>
            <Separator/>
            <Button Content="设置" Command="{Binding OpenSettingsCommand}" Margin="4,2"
                    ToolTip="LLM、书签与通用设置"/>
            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="4,0"/>
        </ToolBar>

        <ToolBar Grid.Row="1">
            <RadioButton Content="选择" GroupName="InkTool" Margin="4,2"
                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Select}"/>
            <RadioButton Content="钢笔" GroupName="InkTool" Margin="4,2"
                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Pen}"/>
            <RadioButton Content="荧光笔" GroupName="InkTool" Margin="4,2"
                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Highlighter}"/>
            <RadioButton Content="橡皮擦" GroupName="InkTool" Margin="4,2"
                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Eraser}"/>
            <RadioButton Content="文本" GroupName="InkTool" Margin="4,2"
                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Text}"
                         ToolTip="点击画布插入文本框，回车确认、Esc 取消"/>
            <RadioButton Content="套索" GroupName="InkTool" Margin="4,2"
                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Lasso}"
                         ToolTip="圈选墨迹笔划，Delete 删除选中的笔划"/>
            <Separator/>
            <Button Content="图片" Margin="4,2" Click="OnInsertImageClick"
                    ToolTip="从文件插入图片到画布（也可 Ctrl+V 粘贴或直接拖入）"/>
            <Button x:Name="UndoButton" Content="撤销" Margin="4,2" IsEnabled="False" Click="OnUndoClick"
                    ToolTip="撤销上一步操作 (Ctrl+Z)"/>
            <Button x:Name="RedoButton" Content="重做" Margin="4,2" IsEnabled="False" Click="OnRedoClick"
                    ToolTip="重做已撤销的操作 (Ctrl+Y)"/>
            <Separator/>
            <TextBlock Text="颜色:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="70" ItemsSource="{Binding PenColors}" SelectedItem="{Binding PenColor}"
                      Margin="2,2">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="40" Height="10" RadiusX="2" RadiusY="2" Margin="0,2">
                            <Rectangle.Fill>
                                <Binding Converter="{StaticResource ColorToBrush}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="荧光:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="70" ItemsSource="{Binding HighlightColors}" SelectedItem="{Binding HighlightColor}"
                      Margin="2,2">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="40" Height="10" RadiusX="2" RadiusY="2" Margin="0,2">
                            <Rectangle.Fill>
                                <Binding Converter="{StaticResource ColorToBrush}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Separator/>
            <Separator/>
            <TextBlock Text="字号:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="56" ItemsSource="{Binding TextFontSizes}" SelectedItem="{Binding TextFontSize}"
                      Margin="2,2" ToolTip="文本框字号（编辑时立即生效）"/>
            <Button Content="B" FontWeight="Bold" Width="26" Margin="2,2" Click="OnBoldClick"
                    ToolTip="加粗（编辑文本框时 Ctrl+B）"/>
            <Button Content="I" FontStyle="Italic" Width="26" Margin="2,2" Click="OnItalicClick"
                    ToolTip="斜体（编辑文本框时 Ctrl+I）"/>
            <Button Width="26" Margin="2,2" Click="OnUnderlineClick"
                    ToolTip="下划线（编辑文本框时 Ctrl+U）">
                <TextBlock Text="U" TextDecorations="Underline"/>
            </Button>
            <TextBlock Text="笔粗:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="52" ItemsSource="{Binding PenWidths}" SelectedItem="{Binding PenWidth}" Margin="2,2"/>
            <TextBlock Text="荧光粗:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="52" ItemsSource="{Binding HighlightWidths}" SelectedItem="{Binding HighlightWidth}" Margin="2,2"/>
            <TextBlock Text="橡皮:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="52" ItemsSource="{Binding EraserWidths}" SelectedItem="{Binding EraserWidth}" Margin="2,2"/>
            <Separator/>
            <TextBlock Text="缩放:" VerticalAlignment="Center" Margin="4,0"/>
            <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" VerticalAlignment="Center" MinWidth="44"
                       Foreground="#FF444444"/>
            <Button Content="重置" Margin="4,2" Click="OnResetZoomClick"/>
        </ToolBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Margin="4,4,0,4">
                <TabItem Header="缩略图">
                    <Grid>
                        <ListBox x:Name="ThumbnailList"
                                 ItemsSource="{Binding Thumbnails}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="OnThumbnailListPreviewMouseWheel"
                                 SelectionChanged="OnThumbnailSelectionChanged"
                                 MouseEnter="OnThumbnailListMouseEnter"
                                 MouseLeave="OnThumbnailListMouseLeave"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#33007ACC"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.CurrentPageBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="3">
                                        <StackPanel>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   MaxHeight="220" MinHeight="40"/>
                                            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"
                                                       FontSize="11" Foreground="#FF555555" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="打开 PDF 后显示缩略图"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Thumbnails.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </TabItem>
                <TabItem Header="书签">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TreeView x:Name="BookmarkTree" Grid.Row="0"
                                  ItemsSource="{Binding Bookmarks}"
                                  Background="Transparent" BorderThickness="0"
                                  SelectedItemChanged="OnBookmarkSelectionChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PageLabel}" Foreground="Gray"
                                                   FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="该 PDF 没有书签目录" HorizontalAlignment="Center"
                                       Foreground="Gray"/>
                            <TextBlock Text="点击下方按钮用 AI 自动生成" HorizontalAlignment="Center"
                                       Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAutoBookmarkButton}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>
                        <Border Grid.Row="1" Padding="8" Background="#FFF7F7F7"
                        BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Margin="0,2" HorizontalAlignment="Stretch"
                                    Visibility="{Binding IsGeneratingBookmarks, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Height="4"/>
                            <TextBlock Text="{Binding BookmarkGenerationStatus}" FontSize="11"
                                       Foreground="#FF555555" HorizontalAlignment="Center"
                                       Margin="0,4,0,2" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="AI 生成书签" Command="{Binding AutoGenerateBookmarksCommand}"
                                HorizontalAlignment="Stretch" Margin="0,2"
                                Visibility="{Binding ShowAutoBookmarkButton, Converter={StaticResource BoolToVis}}"
                                ToolTip="用大模型阅读 PDF 内容，自动生成书签目录"/>
                    </StackPanel>
                </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Column="1" Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <controls:InfiniteCanvas x:Name="Canvas"
                                             Background="White"
                                             Document="{Binding Document}"
                                             Pages="{Binding Pages}"
                                             Zoom="{Binding Zoom, Mode=TwoWay}"
                                             ActiveTool="{Binding ActiveTool}"
                                             PenColor="{Binding PenColor}"
                                             PenWidth="{Binding PenWidth}"
                                             HighlightColor="{Binding HighlightColor}"
                                             HighlightWidth="{Binding HighlightWidth}"
                                             EraserWidth="{Binding EraserWidth}"
                                             TextBorderStyle="{Binding TextBorderStyle}"
                                             TextFontSize="{Binding TextFontSize}"/>
                    <TextBlock Text="打开一个 PDF 文件开始"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="20" Foreground="#FF909090">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ScrollBar Grid.Column="1" Orientation="Vertical" Margin="2,0,0,0"
                           Minimum="0"
                           Maximum="{Binding MaxScrollOffset, ElementName=Canvas}"
                           ViewportSize="{Binding ViewportHeight, ElementName=Canvas}"
                           Value="{Binding ScrollOffset, ElementName=Canvas, Mode=TwoWay}"
                           SmallChange="48" LargeChange="240"/>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Zoom, StringFormat=缩放 {0:P0}}" Margin="12,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="True" Height="16" Width="120"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StatusBarItem>
        </StatusBar>

        <Border x:Name="SaveToast" Grid.RowSpan="4"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,36" Padding="14,8" CornerRadius="6"
                Background="#E6202020" IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="SaveToastText" Foreground="White" FontSize="13"/>
        </Border>
    </Grid>
</Window>
