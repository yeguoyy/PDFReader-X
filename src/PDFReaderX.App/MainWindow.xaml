<Window x:Class="PDFReaderX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PDFReaderX.App.Controls"
        xmlns:converters="clr-namespace:PDFReaderX.App.Converters"
        Title="PDFReader X"
        Icon="Resources/AppLogo.ico"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrush"/>
        <converters:EnumToBoolConverter x:Key="EnumToBool"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Content="打开 PDF" Command="{Binding OpenCommand}" Margin="4,2"/>
            <Button Content="关闭" Command="{Binding CloseCommand}" Margin="4,2"/>
            <Separator/>
            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="4,0"/>
        </ToolBar>

        <ToolBar Grid.Row="1">
            <RadioButton Content="选择" GroupName="InkTool" Margin="4,2"
                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Select}"/>
            <RadioButton Content="钢笔" GroupName="InkTool" Margin="4,2"
                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Pen}"/>
            <RadioButton Content="荧光笔" GroupName="InkTool" Margin="4,2"
                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Highlighter}"/>
            <RadioButton Content="橡皮擦" GroupName="InkTool" Margin="4,2"
                         IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Eraser}"/>
            <Separator/>
            <TextBlock Text="颜色:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="70" ItemsSource="{Binding PenColors}" SelectedItem="{Binding PenColor}"
                      Margin="2,2">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="40" Height="10" RadiusX="2" RadiusY="2" Margin="0,2">
                            <Rectangle.Fill>
                                <Binding Converter="{StaticResource ColorToBrush}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="荧光:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="70" ItemsSource="{Binding HighlightColors}" SelectedItem="{Binding HighlightColor}"
                      Margin="2,2">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="40" Height="10" RadiusX="2" RadiusY="2" Margin="0,2">
                            <Rectangle.Fill>
                                <Binding Converter="{StaticResource ColorToBrush}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Separator/>
            <TextBlock Text="笔粗:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="52" ItemsSource="{Binding PenWidths}" SelectedItem="{Binding PenWidth}" Margin="2,2"/>
            <TextBlock Text="荧光粗:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="52" ItemsSource="{Binding HighlightWidths}" SelectedItem="{Binding HighlightWidth}" Margin="2,2"/>
            <TextBlock Text="橡皮:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox Width="52" ItemsSource="{Binding EraserWidths}" SelectedItem="{Binding EraserWidth}" Margin="2,2"/>
            <Separator/>
            <TextBlock Text="缩放:" VerticalAlignment="Center" Margin="4,0"/>
            <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" VerticalAlignment="Center" MinWidth="44"
                       Foreground="#FF444444"/>
            <Button Content="重置" Margin="4,2" Click="OnResetZoomClick"/>
        </ToolBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Margin="4,4,0,4">
                <TabItem Header="缩略图">
                    <TextBlock Text="缩略图面板（Phase 3）"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                </TabItem>
                <TabItem Header="书签">
                    <TextBlock Text="书签面板（Phase 3）"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                </TabItem>
            </TabControl>

            <Grid Grid.Column="1" Margin="4">
                <controls:InfiniteCanvas x:Name="Canvas"
                                         Background="#FFE8E8E8"
                                         Document="{Binding Document}"
                                         Pages="{Binding Pages}"
                                         Zoom="{Binding Zoom, Mode=TwoWay}"
                                         ActiveTool="{Binding ActiveTool}"
                                         PenColor="{Binding PenColor}"
                                         PenWidth="{Binding PenWidth}"
                                         HighlightColor="{Binding HighlightColor}"
                                         HighlightWidth="{Binding HighlightWidth}"
                                         EraserWidth="{Binding EraserWidth}"/>
                <TextBlock Text="打开一个 PDF 文件开始"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="20" Foreground="#FF909090">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Zoom, StringFormat=缩放 {0:P0}}" Margin="12,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="True" Height="16" Width="120"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
