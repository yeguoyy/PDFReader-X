<Window x:Class="PDFReaderX.App.VisionConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用视觉模式" Height="210" Width="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="无法从该 PDF 提取文本（可能是扫描版或加密文档）。" TextWrapping="Wrap"/>
        <TextBlock Text="是否将页面渲染为图片，交给 AI 识别自动生成书签？（较慢且消耗 API 额度）"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
        <CheckBox x:Name="DontAskBox" Content="不再提示，下次直接使用视觉模式" Margin="0,14,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="使用视觉模式" Width="110" Margin="4" IsDefault="True" Click="OnYesClick"/>
            <Button Content="取消" Width="80" Margin="4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
