<Window x:Class="PDFReaderX.App.ExitConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="退出前保存" SizeToContent="WidthAndHeight" Width="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="有未保存的修改，退出前要保存吗？" TextWrapping="Wrap" FontSize="13"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="保存并退出" Width="100" Margin="4" IsDefault="True" Click="OnSaveClick"/>
            <Button Content="不保存" Width="80" Margin="4" Click="OnDiscardClick"/>
            <Button Content="取消" Width="70" Margin="4" Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
