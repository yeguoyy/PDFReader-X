<Window x:Class="PDFReaderX.App.Controls.NewPenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PDFReaderX.App.Converters"
        Title="新建笔" Width="340" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FFF7F7F7">
    <Window.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrush"/>
        <converters:ColorToHexConverter x:Key="ColorHex"/>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF2D6CDF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE8F0FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <!-- 类型 -->
        <TextBlock Text="类型" FontWeight="SemiBold" FontSize="12" Foreground="#FF333333"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <RadioButton x:Name="PenTypeRadio" Content="钢笔" GroupName="PenType" IsChecked="True"/>
            <RadioButton x:Name="HlTypeRadio" Content="荧光笔" GroupName="PenType" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- 预览 -->
        <Border Height="48" Background="#FFF4F4F4" CornerRadius="3" Margin="0,10,0,0">
            <Grid>
                <Viewbox x:Name="PenPreview" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="26" Height="26">
                        <Path Data="M 4 24 L 13 15 L 15 17 L 6 26 Z" Fill="#FF9A9A9A"/>
                        <Path x:Name="PenPreviewTip" Data="M 13 15 L 22 6 L 15 17 Z" Fill="#FF000000"/>
                        <Path Data="M 13 15 L 17.5 10.5" Stroke="White" StrokeThickness="0.9" Opacity="0.75"/>
                    </Grid>
                </Viewbox>
                <Viewbox x:Name="MarkerPreview" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="Collapsed">
                    <Grid Width="26" Height="26">
                        <Path Data="M 2 22 L 10 14 L 15 19 L 7 27 Z" Fill="#FFB8C8E2"/>
                        <Path x:Name="MarkerPreviewTip" Data="M 10 14 L 19 5 L 24 10 L 15 19 Z" Fill="#FFFFFF00" Opacity="0.55"/>
                        <Path Data="M 10 14 L 15 19" Stroke="#FF7A8AA5" StrokeThickness="1"/>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <!-- 颜色 -->
        <TextBlock Text="颜色" FontWeight="SemiBold" FontSize="12" Foreground="#FF333333" Margin="0,10,0,0"/>
        <ItemsControl x:Name="ColorGrid" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="26" Height="26" Margin="2" Background="{Binding Converter={StaticResource ColorToBrush}}"
                            BorderBrush="#FFC8C8C8" BorderThickness="1" CornerRadius="3" Cursor="Hand"
                            MouseLeftButtonUp="OnColorSwatchClick" ToolTip="{Binding Converter={StaticResource ColorHex}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="其他颜色…" Style="{StaticResource LinkButton}" Click="OnMoreColorsClick" HorizontalAlignment="Left"/>

        <!-- 粗细 -->
        <TextBlock Text="粗细" FontWeight="SemiBold" FontSize="12" Foreground="#FF333333" Margin="0,10,0,0"/>
        <ComboBox x:Name="WidthBox" Width="150" Height="26" Margin="0,4,0,0" HorizontalAlignment="Left"/>

        <!-- 自动名称 -->
        <TextBlock x:Name="NameText" Foreground="#FF888888" FontSize="11" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="添加" Width="76" Height="28" IsDefault="True" Click="OnAddClick"
                    Background="#FF2D6CDF" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="取消" Width="76" Height="28" Margin="10,0,0,0" IsCancel="True" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>