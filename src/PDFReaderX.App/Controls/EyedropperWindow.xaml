<Window x:Class="PDFReaderX.App.Controls.EyedropperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Cursor="None"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseLeftButtonDown="OnPick">
    <Canvas x:Name="Root">
        <!-- 取色十字光标 -->
        <Rectangle x:Name="CrossV" Width="1" Height="19" Fill="#FFFFFFFF" Stroke="#FF444444" StrokeThickness="0.5"/>
        <Rectangle x:Name="CrossH" Width="19" Height="1" Fill="#FFFFFFFF" Stroke="#FF444444" StrokeThickness="0.5"/>
        <!-- 跟随光标的颜色预览 -->
        <Border x:Name="PreviewCard" Padding="6" Background="#EEFFFFFF" BorderBrush="#FFB0B0B0"
                BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <Rectangle x:Name="Swatch" Width="46" Height="46" Stroke="#FF666666" StrokeThickness="1"/>
                <TextBlock x:Name="HexText" FontSize="11" Foreground="#FF222222" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>