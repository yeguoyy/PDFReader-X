<Window x:Class="PDFReaderX.App.Controls.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="颜色" Height="350" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FFF7F7F7">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：色相-饱和度区域 + 亮度/色相条 -->
        <StackPanel Grid.Column="0">
            <Border BorderBrush="#FFC8C8C8" BorderThickness="1" Background="White">
                <Grid x:Name="SvHost" Width="250" Height="158" Background="Transparent"
                      MouseLeftButtonDown="OnSvMouseDown" MouseMove="OnSvMouseMove" MouseLeftButtonUp="OnSvMouseUp">
                    <Image x:Name="SvImage" Stretch="Fill"/>
                    <Canvas x:Name="SvOverlay" IsHitTestVisible="False">
                        <Ellipse x:Name="SvCursorOuter" Width="14" Height="14" Stroke="Black" StrokeThickness="1.5"/>
                        <Ellipse x:Name="SvCursorInner" Width="10" Height="10" Stroke="White" StrokeThickness="2"/>
                    </Canvas>
                </Grid>
            </Border>
            <Border BorderBrush="#FFC8C8C8" BorderThickness="1" Background="White" Margin="0,8,0,0">
                <Grid x:Name="HueHost" Height="16" Background="Transparent"
                      MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove" MouseLeftButtonUp="OnHueMouseUp">
                    <Border x:Name="HueBar">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFF0000" Offset="0"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.167"/>
                                <GradientStop Color="#FF00FF00" Offset="0.333"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                <GradientStop Color="#FF0000FF" Offset="0.667"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.833"/>
                                <GradientStop Color="#FFFF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas x:Name="HueOverlay" IsHitTestVisible="False">
                        <Rectangle x:Name="HueCursor" Width="6" Height="20" Fill="White" Stroke="#FF333333" StrokeThickness="1"/>
                    </Canvas>
                </Grid>
            </Border>
            <TextBlock Text="拖动选择颜色，右侧可输入精确数值" Foreground="#FF888888" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 右：数值输入 + 预览 + 按钮 -->
        <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="红色 (R)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="RBox" VerticalContentAlignment="Center"
                         Height="24" LostFocus="OnRgbLostFocus" KeyDown="OnRgbKeyDown"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="绿色 (G)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="GBox" VerticalContentAlignment="Center"
                         Height="24" LostFocus="OnRgbLostFocus" KeyDown="OnRgbKeyDown"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="蓝色 (B)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="BBox" VerticalContentAlignment="Center"
                         Height="24" LostFocus="OnRgbLostFocus" KeyDown="OnRgbKeyDown"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="十六进制 (H)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="HexBox" VerticalContentAlignment="Center"
                         Height="24" LostFocus="OnHexLostFocus" KeyDown="OnHexKeyDown"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="新增" FontSize="11" Foreground="#FF666666" HorizontalAlignment="Center"/>
                    <Rectangle x:Name="NewColorRect" Width="44" Height="30" Stroke="#FFB0B0B0" StrokeThickness="1" Margin="0,3"/>
                </StackPanel>
                <StackPanel Margin="14,0,0,0">
                    <Rectangle x:Name="OldColorRect" Width="44" Height="30" Stroke="#FFB0B0B0" StrokeThickness="1" Margin="0,3"/>
                    <TextBlock Text="当前" FontSize="11" Foreground="#FF666666" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="确定" Width="76" Height="28" IsDefault="True" Click="OnOkClick"
                        Background="#FF2D6CDF" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="取消" Width="76" Height="28" Margin="10,0,0,0" IsCancel="True" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>